// Ibanez Iceman - outline traced from a product photo.
// Body + (cropped) neck as one silhouette. Reference geometry only:
// the photo had no ruler, so scale rests on ONE assumption below.

body_width = 340.0;   // mm, widest point of the lower bout <-- measure & correct
thickness  = 45;    // mm, korina blank thickness <-- measure & correct

soften = 8;         // mm corner radius - 0 = raw Iceman trace, higher = Jazzmaster
$fn = 64;           // segments on the offset arcs; raise for export

// Round convex AND concave corners at radius r, keeping overall size.
// Reads inside-out: erode r, dilate 2r, erode r
//   = opening (rounds the outside corners) then closing (rounds the inside ones).
module soften_corners(r) {
  if (r <= 0) children();
  else offset(r = -r) offset(r = 2 * r) offset(r = -r) children();
}

